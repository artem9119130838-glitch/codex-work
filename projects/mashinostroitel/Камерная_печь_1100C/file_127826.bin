					b24net-login-enter-form__social-btn
				"
				onclick="BX.util.popup('https://www.facebook.com/dialog/oauth?client_id=784044752479538&amp;redirect_uri=https%3A%2F%2Fwww.bitrix24.ru%2Fcontroller%2Fredirect.php&amp;scope=email&amp;display=popup&amp;state=https%3A%2F%2Fb24-g4wfjq.bitrix24.ru%2Fbitrix%2Ftools%2Foauth%2Ffacebook.php%3Fstate%3Ds1_0_95547d97adaed1b954118319042ffcc6cc9079838f2b80623187e2af', 680, 800)"
				title="Facebook"
