				"
				onclick="BX.util.popup('https://auth2.bitrix24.net/oauth/authorize/?user_lang=ru&amp;client_id=b24.698ecec55197d4.97176535&amp;redirect_uri=https%3A%2F%2Fb24-g4wfjq.bitrix24.ru%2Fbitrix%2Ftools%2Fcrm_show_file.php%3Fauth_service_id%3DBitrix24Net%26fileId%3D127826%26ownerTypeId%3D6%26ownerId%3D54198%26auth%3D&amp;scope=auth,profile&amp;response_type=code&amp;mode=popup&amp;state=s1_0_bdea9d3fa94e693fb8f8cabf13611d88d42b83e0c5cfd0cd95af4b00', 800, 600)"
