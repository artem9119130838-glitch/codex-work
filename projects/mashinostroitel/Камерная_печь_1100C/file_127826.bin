					b24net-icon-btn--social-btn
					b24net-login-enter-form__social-btn
				"
				onclick="BX.util.popup('/bitrix/tools/oauth/twitter.php?check_key=4276d2cdc762b5ebf9488e07d67ccd43&amp;backurl=%252Fbitrix%252Ftools%252Fcrm_show_file.php%253FfileId%253D127826%2526ownerTypeId%253D6%2526ownerId%253D54198%2526auth%253D', 800, 450)"
				title="X"
				type="button"
