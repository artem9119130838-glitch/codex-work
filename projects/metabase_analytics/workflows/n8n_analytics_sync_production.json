    {
      "parameters": {
        "jsCode": "// console.log('starting format for deal', $('Get Deal').item.json.result?.ID);\nconst b24_deal = $('Get Deal').item.json.result || {};\nconst companyNode = $('Get Company').item.json || {};\nconst userNode = $('Get User').item.json || {};\n\nconst companyRes = companyNode.result;\nconst userRes = userNode.result;\n\nconst user = (Array.isArray(userRes) && userRes.length > 0) ? userRes[0] : null;\nconst userName = user ? `${user.NAME || ''} ${user.LAST_NAME || ''}`.trim() : (b24_deal.ASSIGNED_BY_ID || 'Неизвестно');\n\nconst companyName = companyRes && companyRes.TITLE ? companyRes.TITLE : (b24_deal.COMPANY_ID || 'Без компании');\n\nreturn {\n  deal_id: b24_deal.ID,\n  title: b24_deal.TITLE || 'Без названия',\n  stage_id: b24_deal.STAGE_ID || 'NEW',\n  date_create: b24_deal.DATE_CREATE || new Date().toISOString(),\n  date_close: b24_deal.CLOSED === 'Y' ? new Date().toISOString() : null,\n  tender_amount: parseFloat(b24_deal.OPPORTUNITY || 0),\n  customer_name: companyName,\n  responsible_name: userName,\n  raw_data: JSON.stringify(b24_deal)\n};"
      },
