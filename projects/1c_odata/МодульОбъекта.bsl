// Модуль объекта внешнего отчета

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	// Отключаем стандартный вывод отчета
	СтандартнаяОбработка = Ложь;
	
	// 1. Получаем текущие настройки отчета, установленные пользователем
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	
	// 2. Поиск пользовательского параметра периода (типа СтандартныйПериод)
	ПараметрПериод = Настройки.ПараметрыДанных.Элементы.Найти("Период");
	
	Если ПараметрПериод <> Неопределено И ПараметрПериод.Использование Тогда
		ЗначениеПериода = ПараметрПериод.Значение; // Значение параметра типа СтандартныйПериод
		
		// 3. Вычисление точных дат начала и окончания периода
		ДатаНачала = ?(ЗначениеРазглашения(ЗначениеПериода.ДатаНачала), '00010101', ЗначениеПериода.ДатаНачала);
		ДатаОкончания = ?(ЗначениеРазглашения(ЗначениеПериода.ДатаОкончания), '00010101', КонецДня(ЗначениеПериода.ДатаОкончания));
		
		// 4. Принудительно устанавливаем параметры НачалоПериода и КонецПериода (тип Дата) для виртуальных таблиц СКД
		ПараметрНачало = Настройки.ПараметрыДанных.Элементы.Найти("НачалоПериода");
		Если ПараметрНачало <> Неопределено Тогда
			ПараметрНачало.Значение = ДатаНачала;
			ПараметрНачало.Использование = Истина;
		КонецЕсли;
		
		ПараметрКонец = Настройки.ПараметрыДанных.Элементы.Найти("КонецПериода");
		Если ПараметрКонец <> Неопределено Тогда
			ПараметрКонец.Значение = ДатаОкончания;
			ПараметрКонец.Использование = Истина;
		КонецЕсли;
	КонецЕсли;
	
	// Инициализируем границы "всего времени" для накладных расходов, чтобы обойти автозаполнение СКД
	ПараметрНачалоВсего = Настройки.ПараметрыДанных.Элементы.Найти("НачалоВсегоВремени");
	Если ПараметрНачалоВсего <> Неопределено Тогда
		ПараметрНачалоВсего.Значение = '20000101000000';
		ПараметрНачалоВсего.Использование = Истина;
	КонецЕсли;
	
	ПараметрКонецВсего = Настройки.ПараметрыДанных.Элементы.Найти("КонецВсегоВремени");
	Если ПараметрКонецВсего <> Неопределено Тогда
		ПараметрКонецВсего.Значение = '20350101000000';
		ПараметрКонецВсего.Использование = Истина;
	КонецЕсли;
	
	// 5. Выполняем компоновку макета
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);
	
	// 6. Инициализируем процессор компоновки данных
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки, Истина);
	
	// 7. Выводим результат в табличный документ
	ДокументРезультат.Очистить();
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
КонецПроцедуры

// Вспомогательная функция проверки заполнения даты
Функция ЗначениеРазглашения(Значение)
	Возврат Значение = Неопределено Или Значение = '00010101' Или Значение = '00010101000000';
КонецФункции
